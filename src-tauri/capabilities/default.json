{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos de PhotoLab: solo diálogos nativos, lectura/escritura de archivos elegidos y abrir enlaces.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "opener:default",
    "opener:allow-open-path"
  ]
}
