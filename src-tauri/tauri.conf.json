{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoLab",
  "version": "2.0.0",
  "identifier": "mx.photolab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhotoLab — Laboratorio del efecto fotoeléctrico",
        "width": 1200,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#0b1020"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost tauri:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Laboratorio óptico del efecto fotoeléctrico",
    "longDescription": "Simulador didáctico del efecto fotoeléctrico con física real (h·f − Φ), gráficas I–V y Kmax(λ), experimento V₀–f y medición de h.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://TU-SERVIDOR.example.com/photolab/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "TU-CLAVE-PUBLICA-AQUI"
    }
  }
}
